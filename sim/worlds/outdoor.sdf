<?xml version="1.0"?>
<!--
  Outdoor world (ADR-011 section 5, backlog L3 / S1): 120 x 120 m open ground, no ceiling, three
  buildings, a tree row, a fence and bollards; a concrete road surface (mu 0.8) with a grass field
  (mu 0.5) and a wet patch (mu 0.3) whose WheelSlip compliances are switched by the surface node
  (sim/mss_sim/surface.py, values and sources in outdoor.planes.yaml `surfaces` and
  sim/README.md "Outdoor world and wheel slip"). Flat ground: the +-5 cm heightmap and the 3 cm kerb of ADR-011
  section 4 are not modelled (axis-aligned boxes only, tools/gen_sim_assets.py world_boxes).
  Hand-written (first generated by a one-off script, then maintained by hand). World frame w =
  ENU frame e (spherical_coordinates below, heading 0), origin at the centre, z up, ground z = 0.
  Physics: DART, 1 ms step, no real-time lock (section 4).
-->
<sdf version="1.10">
  <world name="outdoor">
    <physics name="dart_1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>0</real_time_factor>
      <real_time_update_rate>0</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.80665</gravity>
    <!-- Must equal origin_lla of the scenarios that use this world (test_worlds.py). -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>21.0278</latitude_deg>
      <longitude_deg>105.8342</longitude_deg>
      <elevation>12.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine><filename>gz-physics-dartsim-plugin</filename></engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- The render engine comes from the gz sim command line (render-engine-server option). -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>false</shadows>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 30 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground: seven non-overlapping tiles, top face z = 0, 0.1 m thick. Surfaces and their
         friction / WheelSlip values: outdoor.planes.yaml `surfaces` (sim/README.md
         "Outdoor world and wheel slip"). -->
    <model name="ground_concrete_north">
      <static>true</static>
      <pose>0 25 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>120 70 0.1</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>120 70 0.1</size></box></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="ground_concrete_south">
      <static>true</static>
      <pose>0 -50 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>120 20 0.1</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>120 20 0.1</size></box></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="ground_concrete_west">
      <static>true</static>
      <pose>-40 -25 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>40 30 0.1</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>40 30 0.1</size></box></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="ground_wet">
      <static>true</static>
      <pose>-14 -25 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12 30 0.1</size></box></geometry>
          <surface><friction><ode><mu>0.3</mu><mu2>0.3</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>12 30 0.1</size></box></geometry>
          <material><ambient>0.3 0.35 0.45 1</ambient><diffuse>0.3 0.35 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="ground_concrete_middle">
      <static>true</static>
      <pose>1 -25 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>18 30 0.1</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>18 30 0.1</size></box></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="ground_grass">
      <static>true</static>
      <pose>25 -25 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>30 30 0.1</size></box></geometry>
          <surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>30 30 0.1</size></box></geometry>
          <material><ambient>0.2 0.6 0.2 1</ambient><diffuse>0.2 0.6 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="ground_concrete_east">
      <static>true</static>
      <pose>50 -25 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20 30 0.1</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>20 30 0.1</size></box></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Buildings (multipath sources for later GNSS zones, ADR-011 section 5). -->
    <model name="building_west">
      <static>true</static>
      <pose>-18 7.5 6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20 15 12</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20 15 12</size></box></geometry>
          <material><ambient>0.75 0.7 0.6 1</ambient><diffuse>0.75 0.7 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="building_east">
      <static>true</static>
      <pose>15 12.5 7.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>20 15 15</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>20 15 15</size></box></geometry>
          <material><ambient>0.75 0.7 0.6 1</ambient><diffuse>0.75 0.7 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="building_north">
      <static>true</static>
      <pose>2.5 36 4.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>15 12 9</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>15 12 9</size></box></geometry>
          <material><ambient>0.75 0.7 0.6 1</ambient><diffuse>0.75 0.7 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Tree row: trunks 0.4 x 0.4 m, 4 m high, every 8 m along y = -5 (x -40..40). -->
    <model name="tree_row">
      <static>true</static>
      <link name="link">
        <collision name="c00"><pose>-40 -5 2 0 0 0</pose><geometry><box><size>0.4 0.4 4</size></box></geometry></collision>
        <visual name="v00"><pose>-40 -5 2 0 0 0</pose><geometry><box><size>0.4 0.4 4</size></box></geometry><material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.4 0.25 0.1 1</diffuse></material></visual>
        <collision name="c01"><pose>-32 -5 2 0 0 0</pose><geometry><box><size>0.4 0.4 4</size></box></geometry></collision>
        <visual name="v01"><pose>-32 -5 2 0 0 0</pose><geometry><box><size>0.4 0.4 4</size></box></geometry><material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.4 0.25 0.1 1</diffuse></material></visual>
        <collision name="c02"><pose>-24 -5 2 0 0 0</pose><geometry><box><size>0.4 0.4 4</size></box></geometry></collision>
        <visual name="v02"><pose>-24 -5 2 0 0 0</pose><geometry><box><size>0.4 0.4 4</size></box></geometry><material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.4 0.25 0.1 1</diffuse></material></visual>
        <collision name="c03"><pose>-16 -5 2 0 0 0</pose><geometry><box><size>0.4 0.4 4</size></box></geometry></collision>
        <visual name="v03"><pose>-16 -5 2 0 0 0</pose><geometry><box><size>0.4 0.4 4</size></box></geometry><material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.4 0.25 0.1 1</diffuse></material></visual>
        <collision name="c04"><pose>-8 -5 2 0 0 0</pose><geometry><box><size>0.4 0.4 4</size></box></geometry></collision>
        <visual name="v04"><pose>-8 -5 2 0 0 0</pose><geometry><box><size>0.4 0.4 4</size></box></geometry><material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.4 0.25 0.1 1</diffuse></material></visual>
        <collision name="c05"><pose>0 -5 2 0 0 0</pose><geometry><box><size>0.4 0.4 4</size></box></geometry></collision>
        <visual name="v05"><pose>0 -5 2 0 0 0</pose><geometry><box><size>0.4 0.4 4</size></box></geometry><material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.4 0.25 0.1 1</diffuse></material></visual>
        <collision name="c06"><pose>8 -5 2 0 0 0</pose><geometry><box><size>0.4 0.4 4</size></box></geometry></collision>
        <visual name="v06"><pose>8 -5 2 0 0 0</pose><geometry><box><size>0.4 0.4 4</size></box></geometry><material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.4 0.25 0.1 1</diffuse></material></visual>
        <collision name="c07"><pose>16 -5 2 0 0 0</pose><geometry><box><size>0.4 0.4 4</size></box></geometry></collision>
        <visual name="v07"><pose>16 -5 2 0 0 0</pose><geometry><box><size>0.4 0.4 4</size></box></geometry><material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.4 0.25 0.1 1</diffuse></material></visual>
        <collision name="c08"><pose>24 -5 2 0 0 0</pose><geometry><box><size>0.4 0.4 4</size></box></geometry></collision>
        <visual name="v08"><pose>24 -5 2 0 0 0</pose><geometry><box><size>0.4 0.4 4</size></box></geometry><material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.4 0.25 0.1 1</diffuse></material></visual>
        <collision name="c09"><pose>32 -5 2 0 0 0</pose><geometry><box><size>0.4 0.4 4</size></box></geometry></collision>
        <visual name="v09"><pose>32 -5 2 0 0 0</pose><geometry><box><size>0.4 0.4 4</size></box></geometry><material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.4 0.25 0.1 1</diffuse></material></visual>
        <collision name="c10"><pose>40 -5 2 0 0 0</pose><geometry><box><size>0.4 0.4 4</size></box></geometry></collision>
        <visual name="v10"><pose>40 -5 2 0 0 0</pose><geometry><box><size>0.4 0.4 4</size></box></geometry><material><ambient>0.4 0.25 0.1 1</ambient><diffuse>0.4 0.25 0.1 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Fence: 100 m long, 1.2 m high, 0.2 m thick, south of the field (y = -50). -->
    <model name="fence_south">
      <static>true</static>
      <pose>0 -50 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>100 0.2 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>100 0.2 1.2</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Bollards 0.3 x 0.3 x 1 m every 15 m along x = 52 and x = -52. -->
    <model name="bollards">
      <static>true</static>
      <link name="link">
        <collision name="c00"><pose>52 -40 0.5 0 0 0</pose><geometry><box><size>0.3 0.3 1</size></box></geometry></collision>
        <visual name="v00"><pose>52 -40 0.5 0 0 0</pose><geometry><box><size>0.3 0.3 1</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material></visual>
        <collision name="c01"><pose>52 -25 0.5 0 0 0</pose><geometry><box><size>0.3 0.3 1</size></box></geometry></collision>
        <visual name="v01"><pose>52 -25 0.5 0 0 0</pose><geometry><box><size>0.3 0.3 1</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material></visual>
        <collision name="c02"><pose>52 -10 0.5 0 0 0</pose><geometry><box><size>0.3 0.3 1</size></box></geometry></collision>
        <visual name="v02"><pose>52 -10 0.5 0 0 0</pose><geometry><box><size>0.3 0.3 1</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material></visual>
        <collision name="c03"><pose>52 5 0.5 0 0 0</pose><geometry><box><size>0.3 0.3 1</size></box></geometry></collision>
        <visual name="v03"><pose>52 5 0.5 0 0 0</pose><geometry><box><size>0.3 0.3 1</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material></visual>
        <collision name="c04"><pose>52 20 0.5 0 0 0</pose><geometry><box><size>0.3 0.3 1</size></box></geometry></collision>
        <visual name="v04"><pose>52 20 0.5 0 0 0</pose><geometry><box><size>0.3 0.3 1</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material></visual>
        <collision name="c05"><pose>52 35 0.5 0 0 0</pose><geometry><box><size>0.3 0.3 1</size></box></geometry></collision>
        <visual name="v05"><pose>52 35 0.5 0 0 0</pose><geometry><box><size>0.3 0.3 1</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material></visual>
        <collision name="c06"><pose>52 50 0.5 0 0 0</pose><geometry><box><size>0.3 0.3 1</size></box></geometry></collision>
        <visual name="v06"><pose>52 50 0.5 0 0 0</pose><geometry><box><size>0.3 0.3 1</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material></visual>
        <collision name="c07"><pose>-52 -40 0.5 0 0 0</pose><geometry><box><size>0.3 0.3 1</size></box></geometry></collision>
        <visual name="v07"><pose>-52 -40 0.5 0 0 0</pose><geometry><box><size>0.3 0.3 1</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material></visual>
        <collision name="c08"><pose>-52 -25 0.5 0 0 0</pose><geometry><box><size>0.3 0.3 1</size></box></geometry></collision>
        <visual name="v08"><pose>-52 -25 0.5 0 0 0</pose><geometry><box><size>0.3 0.3 1</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material></visual>
        <collision name="c09"><pose>-52 -10 0.5 0 0 0</pose><geometry><box><size>0.3 0.3 1</size></box></geometry></collision>
        <visual name="v09"><pose>-52 -10 0.5 0 0 0</pose><geometry><box><size>0.3 0.3 1</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material></visual>
        <collision name="c10"><pose>-52 5 0.5 0 0 0</pose><geometry><box><size>0.3 0.3 1</size></box></geometry></collision>
        <visual name="v10"><pose>-52 5 0.5 0 0 0</pose><geometry><box><size>0.3 0.3 1</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material></visual>
        <collision name="c11"><pose>-52 20 0.5 0 0 0</pose><geometry><box><size>0.3 0.3 1</size></box></geometry></collision>
        <visual name="v11"><pose>-52 20 0.5 0 0 0</pose><geometry><box><size>0.3 0.3 1</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material></visual>
        <collision name="c12"><pose>-52 35 0.5 0 0 0</pose><geometry><box><size>0.3 0.3 1</size></box></geometry></collision>
        <visual name="v12"><pose>-52 35 0.5 0 0 0</pose><geometry><box><size>0.3 0.3 1</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material></visual>
        <collision name="c13"><pose>-52 50 0.5 0 0 0</pose><geometry><box><size>0.3 0.3 1</size></box></geometry></collision>
        <visual name="v13"><pose>-52 50 0.5 0 0 0</pose><geometry><box><size>0.3 0.3 1</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>

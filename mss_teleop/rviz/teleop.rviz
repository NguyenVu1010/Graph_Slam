# RViz2 config of the teleop mode (ADR-031): ros2_node/rviz/mss.rviz plus the graph display.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Map
      Enabled: true
      Topic:
        Value: /mss/map
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      Decay Time: 0
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Path (online estimate)
      Enabled: true
      Topic:
        Value: /mss/path
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Color: 255; 40; 40
      Line Style: Billboards
      Line Width: 0.05
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Keyframe path (optimised)
      Enabled: true
      Topic:
        Value: /mss/graph/path
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Color: 255; 190; 30
      Line Style: Billboards
      Line Width: 0.08
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Keyframes
      Enabled: true
      Topic:
        Value: /mss/graph/keyframes
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Loops
      Enabled: true
      Topic:
        Value: /mss/graph/loops
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: Counts
      Enabled: true
      Topic:
        Value: /mss/graph/counts
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 1
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 30; 30; 36
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 40
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 1.1
      Yaw: -1.5708
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
  Hide Left Dock: false
